\subsection{Věty a definice}

\begin{define}[Prvočíslo]
    \label{def:prvocislo}
    Přirozené číslo $p > 1$ je \emph{prvočíslo}, jestliže jeho jedinými
    děliteli v~$\N$ jsou $1$ a $p$.
\end{define}

\begin{thm}[Euklides]
    \label{thm:euklides}
    Prvočísel je nekonečně mnoho.
\end{thm}

\begin{proof}
    Kdyby jich byl konečný počet, součin všech zvětšený o~jedničku by
    nebyl dělitelný žádným z~nich, a~přitom by musel mít prvočíselného
    dělitele.
\end{proof}

\subsection{Zdrojový kód}

\begin{lstlisting}[language=Python, caption={Prvočíselnost hrubou silou}, label={lst:prime}]
def is_prime(n: int) -> bool:
    if n < 2:
        return False
    return all(n % d for d in range(2, int(n ** 0.5) + 1))
\end{lstlisting}
