{
    // Nastavení rozšíření LaTeX Workshop. Překlad řídí latexmk podle
    // .latexmkrc, aby se stejný projekt dal přeložit i z terminálu.
    "latex-workshop.latex.recipe.default": "latexmk (%%ENGINE%%)",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (%%ENGINE%%)",
            "tools": ["latexmk"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "%%LATEXMK_FLAG%%",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-outdir=build",
                "%DOC%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.autoClean.onBuild": false,
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.autoBuild.run": "onFileChange",
    "latex-workshop.message.error.show": true,
    "latex-workshop.message.warning.show": false,

    "editor.wordWrap": "on",
    "editor.rulers": [80],
    "files.encoding": "utf8",
    "[latex]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "files.associations": {
        "*.tex": "latex"
    }
}
